# Copy to .streamlit/secrets.toml (local) or paste into the app's Secrets box on Streamlit Cloud.
# Never commit the real file.

# Database: Supabase > Connect > Session pooler
DATABASE_URL = "postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Login: Supabase > Project Settings > API (or Connect > App Frameworks)
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# These emails are always admin (comma-separated). Use it for your own login.
ADMIN_EMAILS = "you@example.com"

# Optional: Grafana dashboard link, shown to admins
GRAFANA_URL = "https://YOUR-STACK.grafana.net/d/srtpv-monitoring"
