# Copy to .streamlit/secrets.toml (local) or paste into the app's Secrets box on Streamlit Cloud.
# Never commit the real file.

# Supabase > Connect > Session pooler (paste as shown; postgresql:// is fine)
DATABASE_URL = "postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional: link to your Grafana dashboard, shown as a button on the report
GRAFANA_URL = "https://YOUR-STACK.grafana.net/d/srtpv-monitoring"
